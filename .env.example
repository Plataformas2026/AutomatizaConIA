# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ────────────────────────────────────────────────────
# URL pública HTTPS (Drive solo notifica a HTTPS con certificado válido).
# En local: URL del túnel (cloudflared / ngrok).
NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app

# ── Google Cloud (OAuth + Picker) ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clave de API restringida por referer HTTP y a la "Google Picker API".
NEXT_PUBLIC_GOOGLE_API_KEY=
# Número de proyecto de Google Cloud (no el ID de texto).
NEXT_PUBLIC_GOOGLE_APP_ID=

# ── Secretos propios (genéralos tú) ────────────────────────
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 32  → firma el token de cada canal de Drive y las huellas de alertas
WEBHOOK_SECRET=
# openssl rand -hex 32  → protege /api/cron/renew-watches
CRON_SECRET=

# ── Límites (opcional) ─────────────────────────────────────
# Tamaño máximo de archivo a leer al vuelo, en bytes (por defecto 15 MB).
MAX_FILE_BYTES=15728640

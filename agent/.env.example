# ── Agente local de «Automatización con IA» ─────────────────────────────
# Copia este archivo como  .env  (sin «.example») y rellénalo.
# Los tres primeros valores te los da la web: Dashboard → «Configurar el agente local».

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
AGENT_TOKEN=aci_...

# Carpetas que el agente PUEDE leer, separadas por punto y coma.
# Es una medida de seguridad: fuera de estas carpetas el agente no abre nada.
WATCH_FOLDERS=C:\Users\TU_USUARIO\Documents;D:\Datos

# ── Opcionales ──────────────────────────────────────────────────────────
# Cada cuántos segundos consulta si hay reglas o archivos nuevos (mínimo 10).
POLL_SECONDS=30
# Segundos de calma tras el último cambio antes de leer el archivo (Excel guarda en varios pasos).
DEBOUNCE_SECONDS=3
# Tamaño máximo de archivo que se leerá.
MAX_FILE_MB=50

# ── Correos con Outlook (opcional) ──────────────────────────────────────
# off   (por defecto): los correos de tus reglas quedan «pendientes» en la web y los envías tú.
# draft: el agente los deja en la carpeta Borradores de tu Outlook para que los revises y envíes.
# send : el agente los ENVÍA solo, pero únicamente a los dominios de EMAIL_ALLOWED_DOMAINS.
EMAIL_MODE=off
# Obligatorio con EMAIL_MODE=send. Varios dominios separados por coma (sin @).
EMAIL_ALLOWED_DOMAINS=
# Tope de envíos automáticos por hora (freno de seguridad).
EMAIL_MAX_PER_HOUR=20
# Si tienes VARIAS cuentas en Outlook: dirección de la cuenta donde se crean los borradores
# (y desde la que se envía). Se usa cuando la regla no indica un remitente propio.
# Para ver tus cuentas, ejecuta comprobar_agente.bat.
OUTLOOK_ACCOUNT_EMAIL=

# ── Vista previa y «abrir carpeta» desde el panel web (opcional) ───────────
# Dirección EXACTA de tu web (sin barra final). Con ella, desde la lista de archivos puedes
# ver los datos de un archivo local y abrir su carpeta o el propio archivo. Varias, separadas por coma.
# Los datos de la vista previa van de tu ordenador a tu navegador; no se guardan en ningún sitio.
WEB_ORIGIN=

# ── «Rellenar» plantillas Word desde las alertas (opcional) ─────────────────
# Carpeta donde se guardan los informes rellenados. Por defecto: Documentos\AutomatizaIA
# (necesita WEB_ORIGIN, igual que la vista previa). Los datos de la fila no salen de tu ordenador.
FILL_DIR=

# ── Agente local de «Automatización con IA» ─────────────────────────────
# Copia este archivo como  .env  (sin «.example») y rellénalo.
# Los tres primeros valores te los da la web: Dashboard → «Configurar el agente local».

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
AGENT_TOKEN=aci_...

# Carpetas que el agente PUEDE leer, separadas por punto y coma.
# Es una medida de seguridad: fuera de estas carpetas el agente no abre nada.
WATCH_FOLDERS=C:\Users\TU_USUARIO\Documents;D:\Datos

# ── Opcionales ──────────────────────────────────────────────────────────
# Cada cuántos segundos consulta si hay reglas o archivos nuevos (mínimo 10).
POLL_SECONDS=30
# Segundos de calma tras el último cambio antes de leer el archivo (Excel guarda en varios pasos).
DEBOUNCE_SECONDS=3
# Tamaño máximo de archivo que se leerá.
MAX_FILE_MB=50
